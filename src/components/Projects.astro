---
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';

const featured = projects.find((project) => project.featured) ?? projects[0];
const rest = projects.filter((project) => project !== featured);
---

<section class="section" id="projects">
  <SectionHeading index="03" title="Projects" />

  {
    featured && (
      <div class="projects__featured">
        <ProjectCard project={featured} />
      </div>
    )
  }

  <div class="projects__grid">
    {rest.map((project) => <ProjectCard project={project} />)}

    <a class="projects__more" href="https://github.com/saronzdev" target="_blank" rel="noopener noreferrer">
      <span class="projects__more-title">More on GitHub</span>
      <span class="projects__more-text">Experiments, CLI tools and open source projects.</span>
      <span class="projects__more-arrow" aria-hidden="true">↗</span>
    </a>
  </div>

  <p class="projects__note">
    Want the code behind these? Everything lives on
    <a href="https://github.com/{site.alias}" target="_blank" rel="noopener noreferrer">github.com/{site.alias}</a>.
  </p>
</section>

<style>
  .projects__featured {
    margin-bottom: 44px;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 28px;
  }

  .projects__more {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    min-height: 180px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
  }

  .projects__more:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .projects__more-title {
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .projects__more-text {
    font-size: 14.5px;
    color: var(--muted);
    max-width: 30ch;
  }

  .projects__more-arrow {
    font-size: 18px;
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .projects__more:hover .projects__more-arrow {
    transform: translate(3px, -3px);
  }

  .projects__note {
    margin-top: 36px;
    font-size: 14px;
    color: var(--muted);
  }

  .projects__note a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent-bright);
    text-underline-offset: 3px;
  }

  .projects__note a:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .projects__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
