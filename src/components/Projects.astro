---
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
---

<section class="section" id="projects">
  <SectionHeading index="03" title="Projects" />

  <div class="projects__grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>

  <a class="projects__more" href="https://github.com/saronzdev" target="_blank" rel="noopener noreferrer">
    <span class="projects__more-title">More on GitHub</span>
    <span class="projects__more-text">Experiments, CLI tools and open source projects.</span>
    <span class="projects__more-arrow" aria-hidden="true">↗</span>
  </a>

  <p class="projects__note">
    Want the code behind these? Everything lives on{' '}
    <a href={`https://github.com/${site.alias}`} target="_blank" rel="noopener noreferrer">github.com/{site.alias}</a>.
  </p>
</section>

<style>
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 28px;
  }

  .projects__more {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 44px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .projects__more:hover {
    border-color: var(--accent);
    background: var(--bg-soft);
  }

  .projects__more-title {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .projects__more-text {
    flex: 1;
    min-width: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .projects__more-arrow {
    font-size: 16px;
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .projects__more:hover .projects__more-arrow {
    transform: translate(3px, -3px);
  }

  .projects__note {
    margin-top: 24px;
    font-size: 14px;
    color: var(--muted);
  }

  .projects__note a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent-bright);
    text-underline-offset: 3px;
  }

  .projects__note a:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .projects__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .projects__more {
      flex-wrap: wrap;
      gap: 4px 12px;
    }

    .projects__more-text {
      flex-basis: 100%;
      order: 3;
    }
  }
</style>
