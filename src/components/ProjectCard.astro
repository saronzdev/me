---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const coverBackground = project.coverToneMid
  ? `linear-gradient(140deg, ${project.coverTone} 0%, ${project.coverToneMid} 45%, ${project.coverToneTo} 100%)`
  : `linear-gradient(140deg, ${project.coverTone} 0%, ${project.coverToneTo} 100%)`;
---

<article class="project" data-reveal>
  <figure class="project__cover project__cover--tone" style={`background:${coverBackground}`}>
    <span class="project__monogram" aria-hidden="true">
      {project.name.slice(0, 1)}
    </span>
  </figure>

  <div class="project__body">
    <p class="project__meta">
      <span class="project__name">{project.name}</span>
      <span class="project__status">
        {project.status} · {project.year}
      </span>
    </p>

    <p class="project__description">{project.description}</p>

    <ul class="project__stack">
      {project.stack.map((tech) => <li>{tech}</li>)}
    </ul>

    <ul class="project__links">
      {
        project.links.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .project__cover {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid transparent;
  }

  .project__cover--tone {
    display: grid;
    place-items: center;
  }

  .project__monogram {
    font-size: clamp(40px, 7vw, 64px);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: rgb(255 255 255 / 72%);
    mix-blend-mode: soft-light;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .project:hover .project__monogram {
    transform: scale(1.06);
  }

  .project__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .project__name {
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .project__status {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .project__description {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
    margin-top: 8px;
    max-width: 52ch;
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .project__stack li {
    padding: 3px 9px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 16px;
  }

  .project__links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--fg);
    transition: color 0.18s ease, gap 0.18s ease;
  }

  .project__links a:hover {
    color: var(--accent);
    gap: 9px;
  }
</style>
