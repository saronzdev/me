---
import SectionHeading from './SectionHeading.astro';
import { stack, alsoWith } from '../data/stack';
---

<section class="section" id="stack">
  <SectionHeading index="02" title="Stack" />

  <div class="stack" data-reveal>
    {
      stack.map((item) => (
        <article class="stack__item">
          <h3 class="stack__name">{item.name}</h3>
          <p class="stack__category">{item.category}</p>
        </article>
      ))
    }
  </div>

  <p class="stack__also" data-reveal>
    <span class="stack__also-label">Also working with</span>
    <span class="stack__also-list">
      {alsoWith.map((tool) => <span class="stack__also-item">{tool}</span>)}
    </span>
  </p>
</section>

<style>
  .stack {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .stack__item {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 18px;
    transition: border-color 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
  }

  .stack__item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .stack__name {
    font-size: 15.5px;
    letter-spacing: -0.01em;
  }

  .stack__category {
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
  }

  .stack__also {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 14px;
    margin-top: 24px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .stack__also-label {
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .stack__also-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack__also-item {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 99px;
    color: var(--fg-soft);
  }

  @media (max-width: 720px) {
    .stack {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .stack {
      grid-template-columns: 1fr;
    }
  }
</style>
