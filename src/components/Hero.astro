---
import brand from '../assets/brand.png';
import { hero, site } from '../data/site';
---

<section class="hero">
  <div class="hero__grid">
    <div class="hero__text">
      <p class="hero__badge" data-reveal>
        <span class="hero__dot" aria-hidden="true"></span>
        {site.availability}
      </p>

      <h1 class="hero__title" data-reveal style="--delay: 60ms">
        {hero.headline}
      </h1>

      <p class="hero__lede" data-reveal style="--delay: 120ms">
        {hero.lede}
      </p>

      <div class="hero__actions" data-reveal style="--delay: 180ms">
        <a class="btn btn--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
    </div>

    <figure class="hero__art" data-reveal style="--delay: 140ms">
      <img src={brand.src} width={brand.width} height={brand.height} alt="" />
    </figure>
  </div>

  <dl class="hero__meta" data-reveal style="--delay: 240ms">
    <div>
      <dt>Based in</dt>
      <dd>{site.location}</dd>
    </div>
    <div>
      <dt>Timezone</dt>
      <dd>{site.timezone}</dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd>{site.availability}</dd>
    </div>
  </dl>
</section>

<style>
  .hero {
    padding: 15vh 0 12vh;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    grid-template-areas: 'text art';
    gap: 48px;
    align-items: center;
  }

  .hero__text {
    grid-area: text;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px 5px 10px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 22px;
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 99px;
    background: var(--accent-bright);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-bright) 22%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__dot {
      animation: pulse 2.4s ease-in-out infinite;
    }

    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.35;
      }
    }
  }

  .hero__title {
    font-size: clamp(32px, 5.6vw, 50px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    max-width: 15ch;
  }

  .hero__lede {
    color: var(--muted);
    font-size: 17px;
    max-width: 44ch;
    margin: 20px 0 34px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__art {
    grid-area: art;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    background-color: #0a0a0c;
  }

  .hero__art img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .hero__meta dt {
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }

  .hero__meta dd {
    font-size: 14px;
    color: var(--fg);
  }

  @media (max-width: 820px) {
    .hero__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'text'
        'art';
      gap: 36px;
    }

    .hero__art {
      max-width: 320px;
      justify-self: center;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding: 12vh 0 10vh;
    }

    .hero__meta {
      gap: 20px 28px;
      margin-top: 40px;
    }
  }
</style>
