---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { basePath } from '../lib/paths';
---

<BaseLayout title="404 — Page not found" description="This page does not exist." noindex>
  <Header />
  <main id="main" class="wrap notfound">
    <p class="notfound__code">404</p>
    <h1 class="notfound__title">This page doesn’t exist.</h1>
    <p class="notfound__text">The link may be broken, or the page was moved somewhere else.</p>
    <a class="btn btn--primary" href={basePath}>Back home</a>
  </main>
  <Footer />
</BaseLayout>

<style>
  .notfound {
    padding: 18vh 0 22vh;
  }

  .notfound__code {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.09em;
    color: var(--accent);
  }

  .notfound__title {
    font-size: clamp(28px, 6vw, 44px);
    letter-spacing: -0.03em;
    margin-top: 12px;
  }

  .notfound__text {
    color: var(--muted);
    font-size: 16px;
    margin: 14px 0 30px;
  }
</style>
